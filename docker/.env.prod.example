# 生产环境 Docker 环境变量文件
# 复制此文件为 .env 并根据实际情况修改配置

# ======================
# AI模型配置
# ======================
MODEL_NAME=ZhipuAI/GLM-4.5
BASE_URL=https://api-inference.modelscope.cn/v1
API_KEY=ms-d3532402-86de-4e6d-b60d-158e0851895d

# ======================
# FastAPI应用配置
# ======================
DEBUG=false
HOST=0.0.0.0
PORT=8080
SECRET_KEY=your-super-secure-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ======================
# CORS配置 (生产环境更严格)
# ======================
ALLOWED_HOSTS=["yourdomain.com","api.yourdomain.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE"]
CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-Requested-With"]
CORS_EXPOSE_HEADERS=["*"]
CORS_MAX_AGE=600

# ======================
# 数据库配置
# ======================
MONGO_URI=mongodb://vet_ai_user:your-secure-password@mongo:27017/vet_ai?authSource=vet_ai
MONGO_DB_NAME=vet_ai

# MongoDB初始化配置
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your-very-secure-root-password
MONGO_INITDB_DATABASE=vet_ai

# ======================
# 工作空间配置
# ======================
WORKSPACE_ROOT=/app
EXTERNAL_WORKSPACE_ROOT=/app
INSIDE_DOCKER=true
DATABASE_ECHO=false

# ======================
# LangSmith配置 (可选)
# ======================
LANGSMITH_API_KEY=your-production-langsmith-api-key

# ======================
# 安全配置
# ======================
ALLOWED_ORIGIN=yourdomain.com

# ======================
# Redis配置 (任务队列)
# ======================
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
TASK_QUEUE_MAX_CONCURRENT=5
TASK_QUEUE_RESULT_TTL=3600
