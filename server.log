2026-01-31 02:53:02.416 | INFO     | 18261 | MainThread | core.langgraph.nodes.herb_diagnosis_node:HerbDiagnosisNode:126 | 中医辨证结构化输出成功: zhengming_list=[TCMZhengmingItem(zhengming='脾胃虚弱夹湿', description='金毛犬Lucky出现食欲不振、大便稀溏，乃脾失健运、胃纳失司之象。脾主运化水谷精微，脾虚则水湿内停，下注大肠而致便溏；胃气虚弱则受纳无权，故见食欲不振。结合犬类体质特点，金毛犬多属土性，易伤于饮食，久则中气不足，运化乏力，湿浊内生，符合‘脾胃虚弱夹湿’之证。', probability=0.8, therapy='健脾益气，燥湿和胃，升清降浊'), TCMZhengmingItem(zhengming='脾虚湿盛', description='大便稀溏为湿盛下注之征，食欲不振乃脾虚不运之候。脾为后天之本，主运化水湿，脾虚则水谷不化，湿邪内蕴，困阻中焦，进一步影响胃之受纳。此证以虚为本、湿为标，病位在脾，涉及胃肠，符合‘脾虚湿盛’的病理机制。', probability=0.75, therapy='健脾化湿，理气和中'), TCMZhengmingItem(zhengming='寒湿困脾', description='若环境潮湿或过食生冷，可致寒湿之邪侵袭中焦，困遏脾阳，使脾失健运，症见食欲不振、大便清稀如水样。虽未明言畏寒腹痛，然稀溏之便提示湿邪偏寒，结合外在气候或饲养环境因素，不能排除寒湿困脾之可能。', probability=0.6, therapy='温中散寒，化湿健脾'), TCMZhengmingItem(zhengming='中气不足', description='食欲不振日久，精神未提，提示正气渐衰。中气乃脾胃之气，主司升降运化。中气不足则清阳不升、浊阴不降，导致消化功能减退，粪质不成形。此证多见于慢性病程或年老体弱之犬，属虚损类证候。', probability=0.55, therapy='补中益气，升阳举陷'), TCMZhengmingItem(zhengming='肝郁乘脾', description='若犬只情志不畅，如长期拘禁、惊恐不安，可致肝气郁结，横逆犯脾，使脾失健运，胃失和降，发为食欲减退、大便时溏时干。虽当前症状单一，但临证需考虑情志因素对脏腑功能的影响，尤其在宠物临床中常见肝脾失调之证。', probability=0.45, therapy='疏肝解郁，健脾和胃')]
