2026-01-31 02:49:25.721 | INFO     | 14906 | MainThread | core.langgraph.nodes.herb_diagnosis_node:HerbDiagnosisNode:126 | 中医辨证结构化输出成功: zhengming_list=[TCMZhengmingItem(zhengming='脾胃虚弱夹湿', description='基于金毛犬Lucky食欲不振、大便稀溏等症状，结合中兽医理论分析，食欲不振为脾失健运之象，大便稀溏乃湿浊下注、清浊不分所致，二者并见提示脾胃运化功能减退，水谷精微转输失常，湿邪内生，阻滞中焦气机，符合《元亨疗马集》中‘脾虚则食少，胃弱则泄泻’的论述，故辨为脾胃虚弱夹湿证', probability=0.8, therapy='健脾益气，燥湿和胃，调理中焦'), TCMZhengmingItem(zhengming='脾虚湿盛', description='食欲不振为脾气亏虚、运化无权的表现，大便稀溏且可能质稀量多，为湿浊下渗肠道、传导失司之征，病位在脾，病理性质属虚实夹杂，以脾虚为本，湿盛为标，根据《中兽医学》脾主运化的理论，脾虚不能运化水湿，聚而为患，故成此证', probability=0.75, therapy='健脾化湿，升清降浊'), TCMZhengmingItem(zhengming='寒湿困脾', description='若大便稀溏伴有腹鸣、畏寒喜暖、口色淡白、舌苔白腻等，则为寒湿之邪侵袭中焦，困遏脾阳，致脾失健运，湿浊内停，此属外感寒湿或饮食生冷所致之内伤病证，符合‘湿胜则濡泄’的病机特点', probability=0.65, therapy='温中散寒，化湿健脾'), TCMZhengmingItem(zhengming='脾胃气虚', description='以食欲不振为主症，伴精神稍萎、倦怠乏力、大便时溏时泻、完谷不化，为脾胃气虚、中气不足、受纳运化功能低下所致，病程较久，渐进发展，属虚证范畴，与犬类体质偏弱或年老体衰相关', probability=0.6, therapy='补中益气，健脾养胃'), TCMZhengmingItem(zhengming='肝郁乘脾', description='若Lucky近期有情志刺激如惊吓、环境改变、过度兴奋或抑郁等情况，导致肝气郁结，横逆犯脾，使脾失健运，出现食欲不振、大便稀溏交替发作，肠鸣矢气等症，此为木旺克土之典型病机，常见于情绪波动较大的宠物犬', probability=0.55, therapy='疏肝解郁，健脾和中')]
