2026-01-31 03:09:45.150 | INFO     | 45517 | MainThread | core.langgraph.nodes.herb_diagnosis_node:HerbDiagnosisNode:126 | 中医辨证结构化输出成功: zhengming_list=[TCMZhengmingItem(zhengming='饮食积滞，胃气上逆', description='四个月幼犬脾胃娇嫩，到家后进食并大量饮水，且剧烈蹦跳运动，导致水谷停聚中焦，食滞于胃，气机升降失常，胃气不降反升，故突发呕吐。此为典型饮食所伤、运化不及所致，符合‘饮食自倍，肠胃乃伤’之理。', probability=0.85, therapy='消食导滞，和胃降逆'), TCMZhengmingItem(zhengming='肝胃不和', description='小狗初至新环境，情志兴奋激动，属‘七情’中之骤喜或躁动，致肝气偏亢。肝木乘脾土，影响脾胃运化与气机升降，加之饮食过量，引发胃气上逆而呕吐。其转圈蹦跳之状亦为肝风扰动、气机紊乱之象。', probability=0.7, therapy='疏肝和胃，调和气机'), TCMZhengmingItem(zhengming='脾胃虚弱，运化无力', description='幼犬脏腑未充，尤以脾胃为稚，中气不足，难以承受突然大量饮食及剧烈活动。虽无慢性症状，但禀赋不足，遇诱因即发呕吐，属本虚标实之候，以虚为本，积滞为标。', probability=0.65, therapy='健脾益气，佐以消导'), TCMZhengmingItem(zhengming='水饮停胃', description='一次性饮用三百毫升水对幼犬而言水量过大，易致水饮内停于胃，清浊相干，胃失和降。水饮为阴邪，阻滞中焦，亦可引发突然呕吐，吐出物可能含清水或未消化食物，符合‘水入即吐’之轻证表现。', probability=0.6, therapy='温胃化饮，行气止呕'), TCMZhengmingItem(zhengming='外感气机失调，内动痰扰', description='环境突变属外界‘非时之气’侵扰，影响营卫协调与气机运行。幼犬神气未定，易受外扰致气机逆乱，结合饮食不慎，酿痰动饮，痰气交阻于胃，诱发呕吐。虽无明显寒热表证，但属情志与环境应激所致之内伤气乱。', probability=0.55, therapy='理气解郁，化痰和中')]
