# ============================================================
# Vet-AI 环境变量配置示例
# ============================================================
# 复制此文件为 .env 并填写实际值

# ================== 应用配置 ==================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ================== API文档配置 ==================
# 是否启用API文档（Swagger UI, ReDoc）
# 生产环境可设为true以方便查看API文档
ENABLE_DOCS=true

# ================== 服务器配置 ==================
HOST=0.0.0.0
PORT=8080

# ================== LLM配置 ==================
# 智谱AI模型配置
model_name=Qwen/Qwen3-235B-A22B-Instruct-2507
base_url=https://api-inference.modelscope.cn/v1
api_key=ms-38927370-0f10-46a4-96c6-c5023f4a7480


MODEL_NAME=Qwen/Qwen3-235B-A22B-Instruct-2507
BASE_URL=https://api-inference.modelscope.cn/v1
API_KEY=ms-38927370-0f10-46a4-96c6-c5023f4a7480

# 或者使用ModelScope
# MODEL_NAME=deepseek-ai/DeepSeek-V3
# BASE_URL=https://api-inference.modelscope.cn/v1
# API_KEY=your_modelscope_key_here

# ================== CORS配置 ==================
ALLOWED_HOSTS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]
CORS_EXPOSE_HEADERS=["*"]
CORS_MAX_AGE=3600

# ================== 日志配置 ==================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志保留时间（天）
LOG_RETENTION_DAYS=30

# ================== 任务队列配置 ==================
# 任务工作线程数
TASK_WORKER_CONCURRENCY=2

# 任务超时时间（秒）
TASK_TIMEOUT=600

# ================== 性能配置 ==================
# 最大并发请求数
MAX_CONCURRENT_REQUESTS=10

# 请求超时时间（秒）
REQUEST_TIMEOUT=300
